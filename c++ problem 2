#include <iostream>

using namespace std;

int main() {

    // Declaracion de variables
    int numero1, numero2, suma;

    // Entrada de datos
    cout << "Ingrese el primer numero: ";
    cin >> numero1;

    cout << "Ingrese el segundo numero: ";
    cin >> numero2;

    // Proceso
    suma = numero1 + numero2;

    // Salida
    cout << "\nLa suma es: " << suma << endl;

    return 0;
}

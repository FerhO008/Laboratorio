#include <iostream>
#include <iomanip>

using namespace std;

int main() {

    // Declaracion de variables
    double compra, descuento, total;

    // Entrada de datos
    cout << "Ingrese el monto de la compra: ";
    cin >> compra;

    // Condicion
    if (compra > 100) {

        descuento = compra * 0.10;
        total = compra - descuento;

    }
    else {

        total = compra;

    }

    // Salida
    cout << fixed << setprecision(2);
    cout << "\nEl total a pagar es: " << total << " Bs" << endl;

    return 0;
}

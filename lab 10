#include <iostream>
#include <iomanip>
using namespace std;

int main() {

    // Declaracion de variables
    int N;
    int notas[100];
    int suma = 0;
    int mayor, menor;
    float promedio;

    // Validar cantidad de estudiantes
    do {
        cout << "Ingrese la cantidad de estudiantes: ";
        cin >> N;

        if (N < 1 || N > 100) {
            c << "Error: ingrese un numero entre 1 y 100."
                 << endl;
        }

    } while (N < 1 || N > 100);

    // Registro y validacion de notas
    for (int i = 0; i < N; i++) {

        do {
            cout << "Nota del estudiante " << i + 1 << ": ";
            cin >> notas[i];

            if (notas[i] < 1 || notas[i] > 100) {
                cout << "Nota invalida. Ingrese nuevamente."
                     << endl;
            }

        } while (notas[i] < 1 || notas[i] > 100);

        suma = suma + notas[i];
    }

    // Inicializar mayor y menor
    mayor = notas[0];
    menor = notas[0];

    // Buscar nota mayor y menor
    for (int i = 1; i < N; i++) {

        if (notas[i] > mayor) {
            mayor = notas[i];
        }

        if (notas[i] < menor) {
            menor = notas[i];
        }
    }

    // Calcular promedio
    promedio = (float)suma / N;

    // Mostrar resultados
    cout << "\n===== NOTAS REGISTRADAS =====" << endl;

    for (int i = 0; i < N; i++) {
        cout << notas[i] << " ";
    }

    cout << "\n\nPromedio general: "
         << fixed << setprecision(2) << promedio << endl;

    cout << "Nota mayor: " << mayor << endl;
    cout << "Nota menor: " << menor << endl;

    return 0;
}

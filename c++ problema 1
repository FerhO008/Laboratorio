#include <iostream>

using namespace std;

int main() {

    // Declaracion de variables
    string nombre, apellido, carrera;
    int edad, semestre;

    // Entrada de datos
    cout << "Ingrese su nombre: ";
    cin >> nombre;

    cout << "Ingrese su apellido: ";
    cin >> apellido;

    cout << "Ingrese su edad: ";
    cin >> edad;

    cout << "Ingrese su carrera: ";
    cin >> carrera;

    cout << "Ingrese su semestre: ";
    cin >> semestre;

    // Salida de datos
    cout << "\nNombre completo: " << nombre << " " << apellido << endl;
    cout << "Edad: " << edad << endl;
    cout << "Carrera: " << carrera << endl;
    cout << "Semestre: " << semestre << endl;

    return 0;
}

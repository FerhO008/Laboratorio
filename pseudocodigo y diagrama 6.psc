Algoritmo número_Mayor
	
	Definir num1, num2, mayor Como Real
	
	Escribir "Ingrese el primer numero:"
	Leer num1
	
	Escribir "Ingrese el segundo numero:"
	Leer num2
	
	Si num1 > num2 Entonces
		mayor <- num1
	SiNo
		mayor <- num2
	FinSi
	
	Escribir "El numero mayor es: ", mayor
	
FinAlgoritmo
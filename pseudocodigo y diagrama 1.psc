Algoritmo Registro_de_estudiante
	Definir nombre, carrera Como Cadena
	Definir edad, semestre Como Entero
	Escribir 'Ingrese su nombre completo:'
	Leer nombre
	Escribir 'Ingrese su edad:'
	Leer edad
	Escribir 'Ingrese su carrera:'
	Leer carrera
	Escribir 'Ingrese su semestre:'
	Leer semestre
	Escribir ''
	Escribir 'DATOS DEL ESTUDIANTE'
	Escribir 'Nombre: ', nombre
	Escribir 'Edad: ', edad
	Escribir 'Carrera: ', carrera
	Escribir 'Semestre: ', semestre
FinAlgoritmo
